# Entorno virtual
.venv/

# Python
__pycache__/
*.pyc

# Documentos descargados (se regeneran con scripts/descargar_normativa.py;
# los manifiestos de data/manifests/ sí se versionan)
data/raw/
# Texto extraído y fragmentos (se regeneran con scripts/procesar_normativa.py)
data/processed/
# Índices de búsqueda (se regeneran con scripts/indexar_normativa.py)
data/index/
# Manual de normalización (11 MB; se regenera con scripts/descargar_plantillas.py)
data/plantillas/manual/
# Instancias reales y páginas guardadas de la sede: contienen datos personales, nunca a git
data/plantillas/ejemplos_personales/
data/plantillas/sede/

# Salidas de entrenamiento (adaptadores, checkpoints, logs, modelos fusionados)
outputs/
adapters/
runs/
*.safetensors
*.gguf

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

data/plantillas/aeim_2017/*
data/plantillas/eii/*
